{
  "name": "dashy",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun bin/dashy.ts dev",
    "build": "bun --bun vite build && bun scripts/package-runtime.ts",
    "start": "bun bin/dashy.ts start",
    "preview": "bun bin/dashy.ts start",
    "test": "bun test tests",
    "typecheck": "bun --bun tsc --noEmit",
    "check:build": "bun scripts/check-build.ts",
    "seed": "bun scripts/seed.ts",
    "dashy": "bun bin/dashy.ts",
    "check:extensions": "bun scripts/check-extensions.ts",
    "check:container": "bun scripts/check-container.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@fontsource/space-grotesk": "5.2.8",
    "@solidjs/web": "2.0.0-rc.16",
    "echarts": "6.1.0",
    "exceljs": "4.4.0",
    "jose": "6.1.0",
    "lucide": "1.61.0",
    "solid-js": "2.0.0-rc.16"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@types/bun": "1.3.14",
    "nitro": "3.0.260903-beta",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "overrides": {
    "@solidjs/babel-plugin": "2.0.0-rc.16",
    "@solidjs/compiler": "2.0.0-rc.16",
    "@solidjs/signals": "2.0.0-rc.16"
  },
  "bin": {
    "dashy": "bin/dashy.ts"
  },
  "exports": {
    ".": "./core/index.ts",
    "./types": "./core/types.ts",
    "./ui": "./src/extension-api.ts",
    "./auth": "./core/auth/index.ts",
    "./internal/import-config": "./core/import-config.mjs"
  }
}
