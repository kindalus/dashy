{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": [
      "bun",
      "vite/client",
      "nitro/vite/types"
    ]
  },
  "include": [
    "core",
    "src",
    "scripts",
    "tests",
    "dashy.config.ts",
    "vite.config.ts",
    "samples",
    "bin",
    "examples"
  ]
}
